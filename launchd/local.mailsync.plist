<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Sync mail every 5 minutes. Load: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.mailsync.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.mailsync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/marufjony/.config/neomutt/bin/mailsync</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/marufjony/.local/state/neomutt/mailsync.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/marufjony/.local/state/neomutt/mailsync.log</string>
</dict>
</plist>
