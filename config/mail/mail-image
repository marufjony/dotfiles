#!/usr/bin/env bash
# Show an image in the terminal.
#   mail-image FILE            full screen, press any key to go back
#   mail-image --inline FILE   print a preview into a message (FILE may be -)
# herdr (and anything unknown) can't pass terminal graphics through, so there
# the image is drawn with coloured block characters. Directly in Ghostty,
# kitty or WezTerm (or tmux with allow-passthrough) it uses real pixels.
inline=0
[ "${1:-}" = "--inline" ] && { inline=1; shift; }
file="${1:--}"

pixels=0
if [ -z "${HERDR_ENV:-}" ] && [ -t 1 ]; then
  case "${TERM_PROGRAM:-}:${TERM:-}" in
    ghostty:*|WezTerm:*|*:xterm-kitty|*:xterm-ghostty|tmux:*) pixels=1 ;;
  esac
fi

cols=$(tput cols 2>/dev/null || echo "${COLUMNS:-100}")
rows=$(tput lines 2>/dev/null || echo 40)

if [ "$inline" = 1 ]; then
  # Previews inside a message: always text-safe, at most 100x30
  [ "$cols" -gt 100 ] && cols=100
  chafa -f symbols -c 256 --polite=on --size="${cols}x30" "$file"
  exit
fi

clear
if [ "$pixels" = 1 ]; then
  kitten icat --align=center --stdin=no "$file"
else
  chafa -f symbols --size="${cols}x$((rows - 2))" "$file"
fi
printf '\n  any key to go back'
read -rsn1
[ "$pixels" = 1 ] && kitten icat --clear --stdin=no 2>/dev/null
clear
