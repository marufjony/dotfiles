#!/usr/bin/env bash
# Sync mail, index it with notmuch, and notify about new inbox mail.
#   mailsync               sync every account
#   mailsync marufcorp     sync one account (any mbsync channel or group)
# Runs when you open neomutt or aerc, and when you press o (neomutt)
# or :check-mail (aerc). Passwords come from pass (see ~/.config/isyncrc).
set -u
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

lock="${TMPDIR:-/tmp}/mailsync.$(id -u).lock"
if ! mkdir "$lock" 2>/dev/null; then
  # a lock left by a sync that was killed is cleared; a live one wins
  if kill -0 "$(cat "$lock/pid" 2>/dev/null)" 2>/dev/null; then
    echo "mailsync is already running"; exit 0
  fi
  rm -rf "$lock"; mkdir "$lock" || exit 1
fi
echo $$ > "$lock/pid"
trap 'rm -rf "$lock"' EXIT

mkdir -p "$HOME/.local/share/mail" "$HOME/.local/state/msmtp" "$HOME/.local/state/isync"

# A first-ever index would report every old message as new, so stay quiet then.
first_run=0
[ "$(notmuch count '*' 2>/dev/null || echo 0)" = 0 ] && first_run=1

if [ $# -gt 0 ]; then mbsync "$@"; else mbsync -a; fi
rc=$?

notmuch new --quiet

query='tag:new and folder:/INBOX$/'
count=$(notmuch count "$query")
if [ "$first_run" = 0 ] && [ "$count" -gt 0 ]; then
  body=$(notmuch search --format=json --limit=3 "$query" |
         jq -r '.[] | "\(.authors | split("|")[0]): \(.subject)"')
  osascript -e 'on run argv' \
            -e 'display notification (item 2 of argv) with title (item 1 of argv) sound name "Glass"' \
            -e 'end run' "$count new mail" "$body" >/dev/null 2>&1
fi
notmuch tag -new -- tag:new

# Status for aerc's bottom bar (aerc/filters/mail-status reads these files)
result=ok; [ "$rc" -ne 0 ] && result=failed
mkdir -p "$HOME/.local/state/mail"
for dir in "$HOME/.local/share/mail"/*/; do
  acct=$(basename "$dir")
  # when syncing named accounts, only update those
  if [ $# -gt 0 ] && ! printf '%s\n' "$@" | grep -qx "$acct"; then continue; fi
  printf 'size_kb=%s\nsynced=%s\nresult=%s\n' \
    "$(du -sk "$dir" | cut -f1)" "$(date +%s)" "$result" > "$HOME/.local/state/mail/$acct.status"
done

exit "$rc"
