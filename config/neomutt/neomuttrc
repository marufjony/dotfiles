# NeoMutt main config
#   accounts/   one file per email address (switch with F1, F2, ...)
#   mailcap     how attachments open (PDF, images, xlsx, html)
#   colors      Catppuccin Mocha
#   ~/.config/mail/   mailsync and attachment helpers (shared with aerc)
# Mail is synced by mbsync (~/.config/isyncrc), sent by msmtp, searched by notmuch.

set my_cfg = "~/.config/neomutt"

# ------------------------------------------------------------------ paths
set folder           = "~/.local/share/mail"
set mbox_type        = Maildir
set header_cache     = "~/.cache/neomutt/headers"
set message_cachedir = "~/.cache/neomutt/bodies"
set tmpdir           = "~/.cache/neomutt/tmp"
set mailcap_path     = "$my_cfg/mailcap"
set history_file     = "~/.local/state/neomutt/history"
set save_history     = 1000
set alias_file       = "$my_cfg/aliases"

# ------------------------------------------------------------------ general
set editor         = "nvim +':set tw=72 fo+=w spell'"
set send_charset   = "utf-8"
set wait_key       = no
set sleep_time     = 0
set mail_check     = 30
set timeout        = 15
set beep           = no
set mark_old       = no
set delete         = yes
set quit           = yes
set confirm_append = no
set move           = no
set abort_key      = "<Esc>"
set mail_check_stats

# ------------------------------------------------------------------ index
set use_threads  = threads
set sort         = reverse-last-date
set sort_aux     = date
set strict_threads
set date_format  = "%d %b %H:%M"
set index_format = "%4C %Z %D  %-22.22F %?X?📎 ?%s"
set to_chars     = " +TCFL"
set menu_scroll

# ------------------------------------------------------------------ pager
set pager_index_lines = 8
set pager_context     = 3
set pager_stop
set tilde
unset markers
set smart_wrap
set allow_ansi
auto_view text/html application/pdf application/vnd.openxmlformats-officedocument.wordprocessingml.document application/vnd.openxmlformats-officedocument.spreadsheetml.sheet text/csv
alternative_order text/plain text/enriched text/html
ignore *
unignore from: to: cc: date: subject: reply-to:
hdr_order from: to: cc: date: subject:

# ------------------------------------------------------------------ compose / reply
set real_name        = "Maruf Jony"
set use_from
set envelope_from
set reverse_name
set fast_reply
set include
set edit_headers
set text_flowed
set forward_format   = "Fwd: %s"
set forward_quote
set mime_forward     = ask-no
set fcc_attach
set attribution      = "On %d, %n wrote:"
set reply_regex      = "^((re|aw|sv|fwd?)(\\[[0-9]+\\])?:[ \t]*)*"
set abort_noattach   = ask-yes
set abort_noattach_regex = "\\<(attach|attached|attachment|bifoga|bifogad)\\>"

# ------------------------------------------------------------------ sidebar
set sidebar_visible
set sidebar_width         = 28
set sidebar_short_path
set sidebar_folder_indent
set sidebar_indent_string = "  "
set sidebar_format        = "%D%?F? ★%F?%* %?N?%N/?%?S?%S?"
set sidebar_non_empty_mailbox_only = no

# ------------------------------------------------------------------ notmuch (search + unified inbox)
set nm_default_url  = "notmuch:///Users/marufjony/.local/share/mail"
set nm_record       = no
set virtual_spool_file = no
virtual-mailboxes "★ All inboxes" "notmuch://?query=folder:/INBOX$/"
virtual-mailboxes "★ Unread"      "notmuch://?query=tag:unread and folder:/INBOX$/"
virtual-mailboxes "★ Flagged"     "notmuch://?query=tag:flagged"

# ------------------------------------------------------------------ keys (vim-like)
bind index,pager g noop
bind index        gg first-entry
bind index        G  last-entry
bind pager        gg top
bind pager        G  bottom
bind index        j  next-entry
bind index        k  previous-entry
bind pager        j  next-line
bind pager        k  previous-line
bind index,pager  \Cd half-down
bind index,pager  \Cu half-up
bind index        l  display-message
bind pager,attach h  exit
bind index        h  noop
bind index        za collapse-thread
bind index        zA collapse-all
bind index,pager  R  group-reply
bind index,pager  N  search-opposite
bind index        D  delete-message
bind index        u  undelete-message
bind index        <space> tag-entry
bind index,pager  F  flag-message
bind editor       <Tab> complete-query
# Tab in To:/Cc: completes from every address in your mail
set query_command = "echo; notmuch address --deduplicate=address --output=sender --output=recipients -- %s | sed -E 's/^(.*) <(.*)>$/\\2\t\\1/'"
source $my_cfg/aliases

# sidebar: Ctrl-j / Ctrl-k move, Ctrl-o opens, B hides
bind index,pager \Cj sidebar-next
bind index,pager \Ck sidebar-prev
bind index,pager \Co sidebar-open
bind index,pager B   sidebar-toggle-visible

# search all accounts with notmuch: \ then a query (from:alice, subject:invoice, date:1w..)
bind index,pager \\ vfolder-from-query
# o = sync now
macro index o "<shell-escape>~/.config/mail/mailsync<enter>" "sync all mail now"
# U = list the links in this message; pick one and it opens in your default browser
macro index,pager U "<pipe-message>urlscan --dedupe --single --run-safe 'open {}'<enter>" "open a link in the browser"
# gi/ga/gs/gd/gt = go to inbox, archive, sent, drafts, trash; gu = all inboxes
macro index,pager gu "<change-vfolder>★ All inboxes<enter>" "unified inbox"
# A = archive (Gmail: removes from inbox, keeps in All Mail)
macro index,pager A "<save-message>$my_archive<enter>" "archive"

# attachments (press v on a message):
#   Enter / l = full view in the terminal,  o = open in the macOS app,
#   S = save to Downloads
bind  attach <return> view-mailcap
bind  attach l view-mailcap
macro attach o "<enter-command>set mailcap_path=$my_cfg/mailcap.open<enter><view-mailcap><enter-command>set mailcap_path=$my_cfg/mailcap<enter>" "open in macOS app"
macro attach S "<save-entry><kill-line>~/Downloads/<enter>" "save to Downloads"

# ------------------------------------------------------------------ accounts
macro index,pager <F1> "<sync-mailbox><enter-command>source $my_cfg/accounts/marufcorp.muttrc<enter><change-folder>!<enter>" "marufcorp@gmail.com"

source $my_cfg/colors.muttrc
source $my_cfg/accounts/marufcorp.muttrc
