# Catppuccin Mocha for NeoMutt, as the nearest of the 256 standard colours
# (exact hex needs TERM=xterm-direct, which none of your terminals use).
# #181825=234  #1e1e2e=234  #313244=236  #45475a=238  #6c7086=243  #74c7ec=117  #7f849c=103  #89b4fa=111  #89dceb=116  #94e2d5=116  #a6adc8=146  #a6e3a1=151  #b4befe=147  #cba6f7=183  #cdd6f4=189  #f38ba8=211  #f5c2e7=218  #f5e0dc=224  #f9e2af=223  #fab387=216

color normal          default  default
color error           color211  default
color warning         color216  default
color message         color189  default
color prompt          color183  default
color indicator       default  color236
color tree            color183  default
color search          color234  color223
color markers         color211  default
color tilde           color238  default

# ---- bottom bar: base, then each part by its icon
color status          color146  color234
color status          color238  color234 "│"
color status          color183  color234 " [^│]+"
color status          color147  color234 "(||||||||)  [A-Za-z ]+"
color status          color111  color234 " [0-9]+ unread"
color status          color216  color234 " [0-9.]+ [KMG]B"
color status          color116  color234 " [^│]+"
color status          color151  color234 " Connected"
color status          color223  color234 " Syncing"
color status          color211  color234 " [A-Za-z ]+"

# ---- message list
color index           color189  default ~A
color index_author    color147  default ~A
color index_subject   color189  default ~A
color index_date      color103  default ~A
color index_flags     color243  default ~A
color index_author    bold color111 default ~N
color index_subject   bold color189 default ~N
color index_flags     color111  default ~N
color index_flags     color151  default ~Q
color index_flags     color223  default ~F
color index_author    color223  default ~F
color index_flags     color183  default ~T
color index           color243  default ~D
color index_author    color243  default ~D
color index_subject   color243  default ~D
color index_flags     color211  default ~D

# ---- sidebar
color sidebar_ordinary   color146 default
color sidebar_spool_file color111 default
color sidebar_unread     bold color111 default
color sidebar_new        color116 default
color sidebar_flagged    color223 default
color sidebar_highlight  color189 color236
color sidebar_indicator  bold color183 color236
color sidebar_divider    color238 default

# ---- message
color hdrdefault      color103  default
color header          color183  default "^From:"
color header          bold color111 default "^Subject:"
color header          color146  default "^(To|Cc|Date|Reply-To):"
color quoted          color147  default
color quoted1         color116  default
color quoted2         color216  default
color quoted3         color218  default
color signature       color243  default
color attachment      color216  default
color body            underline color117 default "(https?|ftp)://[^ \t\">)]+"
color body            color117  default "[-a-z_0-9.%$+]+@[-a-z_0-9.]+\\.[-a-z][-a-z]+"
color body            color151  default "^gpg: Good signature.*"
color body            color211  default "^gpg: BAD signature.*"
