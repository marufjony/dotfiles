# How NeoMutt shows attachments. (NeoMutt has no "*/*" wildcard; each major
# type is listed.) The full-screen viewer is ~/.config/mail/mail-view.
#
#   Inside a message: text previews of PDF, Word, Excel and HTML parts
#   (the copiousoutput lines). Images are not previewed inline (too blurry).
#   Attachment list (press v):
#     Enter / l   full view in the terminal (this file)
#     o           open in the macOS app (mailcap.open)

# Order matters: Enter uses the first matching line; previews use the
# first matching line marked copiousoutput.

# full view (Enter / l)
text/html; w3m -I %{charset} -T text/html %s; needsterminal; nametemplate=%s.html
application/*; ~/.config/mail/mail-view %s; needsterminal
image/*; ~/.config/mail/mail-view %s; needsterminal
text/*; ~/.config/mail/mail-view %s; needsterminal
audio/*; ~/.config/mail/mail-open %s
video/*; ~/.config/mail/mail-open %s

# text previews shown inside the message
text/html; w3m -I %{charset} -T text/html -dump -o display_link_number=1 %s; copiousoutput; nametemplate=%s.html
application/pdf; pdftotext -layout -l 20 %s -; copiousoutput
application/vnd.openxmlformats-officedocument.wordprocessingml.document; pandoc -f docx -t plain %s; copiousoutput
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet; ~/.config/mail/xlsx-preview %s; copiousoutput
text/csv; column -s, -t %s; copiousoutput
