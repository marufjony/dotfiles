# Used by o in the attachment list: open in the default macOS app
# (Preview for PDF/images, Word for docx, Excel for xlsx, ...)
application/*; ~/.config/mail/mail-open %s
image/*; ~/.config/mail/mail-open %s
text/*; ~/.config/mail/mail-open %s
audio/*; ~/.config/mail/mail-open %s
video/*; ~/.config/mail/mail-open %s
message/*; ~/.config/mail/mail-open %s
